# --- Data: never commit signal arrays or datasets, only the folder skeleton ---
data/**
!data/**/
!data/**/.gitkeep

# --- Model checkpoints (use Git LFS if one truly must be shared) ---
*.pt
*.pth
*.onnx
*.ckpt

# --- Evaluation + training outputs (regenerated by the pipeline) ---
evals/**
!evals/.gitkeep
results/**
!results/.gitkeep
runs/
wandb/
lightning_logs/

# Raw array formats, wherever they land
*.npy
*.npz
*.h5
*.hdf5

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
venv/
.venv/
env/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ensemble members
results/ensemble_*.pt

# SEDIC brand asset -- not ours to redistribute; drop it in locally
assets/sedic_logo.png
