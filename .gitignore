# --- Data: never commit signal arrays or datasets, only the folder skeleton ---
data/**
!data/**/
!data/**/.gitkeep

# --- Model checkpoints (use Git LFS if one truly must be shared) ---
*.pt
*.pth
*.onnx
*.ckpt
# ...except the static site's own copies. A static host serves the repo with
# no Python available to run web/build.py, so these have to be in git for the
# deployed page to have a model at all. ~630 KB each; regenerate with
# scripts/export_onnx.py then web/build.py.
!web/models/*.onnx

# --- Evaluation + training outputs (regenerated by the pipeline) ---
evals/**
!evals/.gitkeep
results/**
!results/.gitkeep
runs/
wandb/
lightning_logs/

# Raw array formats, wherever they land
*.npy
*.npz
*.h5
*.hdf5

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
venv/
.venv/
env/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ensemble members
results/ensemble_*.pt

# generated by scripts/export_verification_pack.py
verification_pack/

# Local experiment and UI run logs -- transient, per-machine.
docs/experiments/*.log
ui_output*.log
panel_preview.html

# Node is only used for the static build's parity tests (web/test/*.mjs),
# which install onnxruntime-node on demand -- never a runtime dependency.
node_modules/
package-lock.json

# NOTE: web/index.html and web/models/*.onnx are GENERATED by web/build.py but
# are deliberately COMMITTED anyway -- a static host (Vercel/GitHub Pages)
# serves the repo as-is with no Python available to run the build, so the
# generated artifacts have to be in git for the site to work. Re-run
# web/build.py and commit the result after changing the template or the
# checkpoints.

# Parity-test fixtures, regenerated by web/test/*_reference.py.
web/test/*.json
